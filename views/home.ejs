<% layout("layouts/boilerplate.ejs") -%>

<style>

    .hero-wrap {
        min-height: 88vh;
        display: flex;
        align-items: center;
        padding: 70px 0;
    }

    .brand-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.09);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #c7d2fe;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .hero-title {
        font-size: clamp(2.4rem, 6vw, 5rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -2px;
        margin-bottom: 20px;
    }

    .gradient-text {
        background: linear-gradient(135deg, #60a5fa, #a78bfa, #34d399);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        max-width: 620px;
        color: #cbd5e1;
        font-size: 1.08rem;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    .hero-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 35px;
    }

    .btn-primary-glow {
        padding: 12px 24px;
        border-radius: 999px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.35);
        transition: 0.3s;
    }

    .btn-primary-glow:hover {
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 24px 55px rgba(124, 58, 237, 0.45);
    }

    .btn-soft {
        padding: 12px 24px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: #e2e8f0;
        font-weight: 800;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.18);
        transition: 0.3s;
    }

    .btn-soft:hover {
        color: white;
        background: rgba(255, 255, 255, 0.14);
        transform: translateY(-3px);
    }

    .stats-row {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .stat-card {
        min-width: 140px;
        padding: 14px 18px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.075);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(18px);
    }

    .stat-card h4 {
        font-weight: 900;
        margin-bottom: 2px;
    }

    .stat-card span {
        color: #94a3b8;
        font-size: 0.85rem;
    }

    .preview-card {
        position: relative;
        border-radius: 32px;
        padding: 24px;
        background: rgba(255, 255, 255, 0.09);
        border: 1px solid rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(24px);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    }

    .vault-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .vault-logo {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        box-shadow: 0 18px 35px rgba(37, 99, 235, 0.35);
        font-size: 1.4rem;
    }

    .vault-chip {
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.14);
        color: #86efac;
        font-weight: 800;
        font-size: 0.78rem;
    }

    .doc-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        border-radius: 18px;
        background: rgba(15, 23, 42, 0.58);
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 12px;
    }

    .doc-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: rgba(59, 130, 246, 0.16);
        color: #93c5fd;
    }

    .doc-title {
        font-weight: 800;
        margin-bottom: 2px;
    }

    .doc-meta {
        color: #94a3b8;
        font-size: 0.82rem;
    }

    .price-tag {
        margin-left: auto;
        padding: 6px 11px;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.16);
        color: #86efac;
        font-weight: 900;
        font-size: 0.8rem;
    }

    .floating-badge {
        position: absolute;
        top: -18px;
        right: -12px;
        padding: 10px 16px;
        border-radius: 999px;
        background: linear-gradient(135deg, #f97316, #ef4444);
        color: white;
        font-weight: 900;
        box-shadow: 0 16px 40px rgba(239, 68, 68, 0.35);
        animation: floatBadge 2s infinite ease-in-out;
    }

    @keyframes floatBadge {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    .section-title {
        font-weight: 900;
        letter-spacing: -1px;
    }

    .feature-section {
        padding: 30px 0 90px;
    }

    .feature-card {
        height: 100%;
        padding: 26px;
        border-radius: 26px;
        background: rgba(255, 255, 255, 0.075);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(18px);
        transition: 0.3s;
    }

    .feature-card:hover {
        transform: translateY(-8px);
        background: rgba(255, 255, 255, 0.11);
    }

    .feature-icon {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: rgba(96, 165, 250, 0.15);
        color: #93c5fd;
        font-size: 1.35rem;
        margin-bottom: 16px;
    }

    .feature-card p {
        color: #94a3b8;
        margin-bottom: 0;
    }

    @media (max-width: 991px) {
        .hero-wrap {
            text-align: center;
        }

        .hero-subtitle {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-actions,
        .stats-row {
            justify-content: center;
        }

        .preview-card {
            margin-top: 40px;
        }
    }

    @media (max-width: 576px) {
        .hero-wrap {
            padding: 45px 0;
        }

        .preview-card {
            padding: 18px;
            border-radius: 24px;
        }

        .doc-item {
            padding: 12px;
        }

        .price-tag {
            display: none;
        }
    }
</style>

<div class="home-page">

    <section class="hero-wrap">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <div class="brand-pill">
                        <i class="fa-solid fa-shield-halved"></i>
                        NoteVault Prime
                    </div>

                    <h1 class="hero-title">
                        Store, filter & access your
                        <span class="gradient-text">study PDFs</span>
                        faster.
                    </h1>

                    <p class="hero-subtitle">
                        A premium PDF library for notes, micro content and projects — organized by branch,
                        semester and category with a smooth student-friendly experience.
                    </p>

                    <div class="hero-actions">
                        <a href="/pdfs" class="btn-primary-glow">
                            <i class="fa-solid fa-layer-group me-2"></i>
                            Explore Library
                        </a>

                        <a href="/pdfs/new" class="btn bg-primary ">
                            <i class="fa-solid fa-cloud-arrow-up me-2"></i>
                             <b>Upload PDF</b>
                        </a>
                    </div>

                    <div class="stats-row">
                        <div class="stat-card">
                            <h4>Branch</h4>
                            <span>Smart sorting</span>
                        </div>

                        <div class="stat-card">
                            <h4>Sem</h4>
                            <span>Easy filtering</span>
                        </div>

                        <div class="stat-card">
                            <h4>₹</h4>
                            <span>Price based access</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="preview-card">
                        <div class="floating-badge">
                            NEW
                        </div>

                        <div class="vault-header">
                            <div class="d-flex align-items-center gap-3">
                                <div class="vault-logo">
                                    <i class="fa-solid fa-box-archive"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold">NoteVault Library</h5>
                                    <small class="text-secondary">Organized academic vault</small>
                                </div>
                            </div>

                            <span class="vault-chip">
                                Live Filters
                            </span>
                        </div>

                        <div class="doc-item">
                            <div class="doc-icon">
                                <i class="fa-solid fa-book-open"></i>
                            </div>
                            <div>
                                <div class="doc-title">BCA Notes Pack</div>
                                <div class="doc-meta">Semester 3 · Notes</div>
                            </div>
                            <div class="price-tag">₹5</div>
                        </div>

                        <div class="doc-item">
                            <div class="doc-icon">
                                <i class="fa-solid fa-flask-vial"></i>
                            </div>
                            <div>
                                <div class="doc-title">Micro Questions</div>
                                <div class="doc-meta">B.Tech · Semester 2</div>
                            </div>
                            <div class="price-tag">₹10</div>
                        </div>

                        <div class="doc-item">
                            <div class="doc-icon">
                                <i class="fa-solid fa-diagram-project"></i>
                            </div>
                            <div>
                                <div class="doc-title">Project Reports</div>
                                <div class="doc-meta">MBA · Projects</div>
                            </div>
                            <div class="price-tag">₹15</div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="feature-section">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="section-title">Everything students need</h2>
                <p class="text-secondary">Clean upload, organized library and fast access in one place.</p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fa-solid fa-filter"></i>
                        </div>
                        <h5 class="fw-bold">Smart Filters</h5>
                        <p>Search content by branch, semester, category and price without confusion.</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <h5 class="fw-bold">Easy Upload</h5>
                        <p>Upload study PDFs with title, price, branch, semester and category.</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <h5 class="fw-bold">Fast Access</h5>
                        <p>Users can browse, pay and download PDFs with a smooth modern interface.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

</div>