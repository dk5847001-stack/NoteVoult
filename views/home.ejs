<% layout("layouts/boilerplate.ejs") -%>

    <link rel="stylesheet" href="/css/home.css">
    <div class="home-page">

        <section class="hero-wrap">
            <div class="container">
                <div class="row align-items-center g-5">

                    <div class="col-lg-6">
                        <div class="brand-pill">
                            <i class="fa-solid fa-shield-halved"></i>
                            NoteVault Prime
                        </div>

                        <h1 class="hero-title">
                            Store, filter & access your
                            <span class="gradient-text">study PDFs</span>
                            faster.
                        </h1>

                        <p class="hero-subtitle">
                            A premium PDF library for notes, micro content and projects — organized by branch,
                            semester and category with a smooth student-friendly experience.
                        </p>
                        <div class="hero-actions">
                            <a href="/pdfs" class="btn-primary-glow">
                                <i class="fa-solid fa-layer-group me-2"></i>
                                Explore Library
                            </a>

                            <a href="https://examnovaai.onrender.com/marketplace" class="btn-primary-glow">
                                <i class="fa-solid fa-layer-group me-2"></i>
                                Visit Official Website
                            </a>

                            <a href="/pdfs/new" class="btn bg-primary ">
                                <i class="fa-solid fa-cloud-arrow-up me-2"></i>
                                <b>Upload PDF</b>
                            </a>
                        </div>

                        <div class="stats-row">
                            <div class="mb-3 mt-3 stat-card">
                                <h4>Branch</h4>
                                <span>Smart sorting</span>
                            </div>

                            <div class="mb-3 stat-card">
                                <h4>Sem</h4>
                                <span>Easy filtering</span>
                            </div>

                            <div class="stat-card">
                                <h4>₹</h4>
                                <span>Price based access</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="preview-card">
                            <div class="floating-badge">
                                NEW
                            </div>

                            <div class="vault-header">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="vault-logo">
                                        <i class="fa-solid fa-box-archive"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-0 fw-bold">NoteVault Library</h5>
                                        <small class="text-secondary">Organized academic vault</small>
                                    </div>
                                </div>

                                <span class="vault-chip">
                                    Live Filters
                                </span>
                            </div>

                            <div class="doc-item">
                                <div class="doc-icon">
                                    <i class="fa-solid fa-book-open"></i>
                                </div>
                                <div>
                                    <div class="doc-title">B.Tech/BCA Notes Pack</div>
                                    <div class="doc-meta">All Semester · Notes</div>
                                </div>
                                <div class="price-tag">₹25</div>
                            </div>

                            <div class="doc-item">
                                <div class="doc-icon">
                                    <i class="fa-solid fa-flask-vial"></i>
                                </div>
                                <div>
                                    <div class="doc-title">Micro Questions</div>
                                    <div class="doc-meta">B.Tech · Semester 4</div>
                                </div>
                                <div class="price-tag">₹5</div>
                            </div>

                            <div class="doc-item">
                                <div class="doc-icon">
                                    <i class="fa-solid fa-diagram-project"></i>
                                </div>
                                <div>
                                    <div class="doc-title">Project Reports</div>
                                    <div class="doc-meta">B.Tech · Projects</div>
                                </div>
                                <div class="price-tag">₹1599</div>
                            </div>
                            <a href="/contactUs" class="footer-action-btn">
                                <span><i class="fa-solid fa-headset"></i>&nbsp; Contact Us</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>

                        </div>
                    </div>

                </div>
            </div>
        </section>

        <section class="quick-action-section">
            <div class="container">
                <div class="row g-4 align-items-stretch">

                    <div class="col-lg-8">
                        <div class="quick-card h-100">

                            <h2 class="quick-title">
                                <i class="fa-solid fa-bolt me-2 text-warning"></i>
                                Quick Action
                            </h2>

                            <% if(currUser){ %>
                                <p class="quick-subtitle mb-0">
                                    Hello, <strong>
                                        <%= currUser.username %>
                                    </strong> 👋 welcome to home page.
                                    Here you can access all features of the website.
                                </p>

                                <div class="user-info-grid">
                                    <div class="user-info-box">
                                        <span>Username</span>
                                        <strong>
                                            <%= currUser.username %>
                                        </strong>
                                    </div>

                                    <div class="user-info-box">
                                        <span>Email</span>
                                        <strong>
                                            <%= currUser.email %>
                                        </strong>
                                    </div>

                                    <div class="user-info-box">
                                        <span>Role</span>
                                        <strong>
                                            <%= currUser.role %>
                                        </strong>
                                    </div>

                                    <div class="user-info-box">
                                        <span>Status</span>
                                        <strong>
                                            <%= currUser.isBlocked==="blocked" ? "Blocked" : "Active" %>
                                        </strong>
                                    </div>
                                </div>

                                <% } else { %>
                                    <p class="quick-subtitle mb-0">
                                        Hello, Student 👋 welcome to home page. Here you can access limited features.
                                        For full access and better experience please
                                        <a href="/register" class="register-link">Register Now!</a>
                                    </p>
                                    <% } %>

                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="quick-actions-card">
                            <h5>
                                <i class="fa-solid fa-grid-2 me-2"></i>
                                Actions
                            </h5>

                            <div class="quick-action-list">

                                <a class="quick-action-btn" href="/pdfs">
                                    <span><i class="fa-solid fa-file-pdf"></i> View All PDFs</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>

                                <a class="quick-action-btn light" href="/pdfs">
                                    <span><i class="fa-solid fa-book-open"></i> View All Micro</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>

                                <a class="quick-action-btn light" href="/pdfs">
                                    <span><i class="fa-solid fa-note-sticky"></i> View All Notes</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>

                                <a class="quick-action-btn light" href="/pdfs">
                                    <span><i class="fa-solid fa-diagram-project"></i> View All Projects</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                
                                <a href="/contactUs" class="footer-action-btn">
                                <span><i class="fa-solid fa-headset"></i>&nbsp; Contact Us</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>

                                <% if(currUser){ %>
                                    <a class="quick-action-btn" href="/pdfs/new">
                                        <span><i class="fa-solid fa-cloud-arrow-up"></i> Upload PDF</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>

                                    <a class="quick-action-btn light" href="/pdfs">
                                        <span><i class="fa-solid fa-user"></i> Go to Profile</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>

                                    <% if(currUser.role==="admin" ){ %>
                                        <a class="quick-action-btn admin" href="/admin">
                                            <span><i class="fa-solid fa-user-shield"></i> Admin Dashboard</span>
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </a>

                                        <a class="quick-action-btn admin" href="/subscribers">
                                            <span><i class="fa-solid fa-users"></i> View Subscribers</span>
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                        <% } %>

                                            <a class="quick-action-btn danger" href="/logout">
                                                <span><i class="fa-solid fa-right-from-bracket"></i> Logout</span>
                                                <i class="fa-solid fa-arrow-right"></i>
                                            </a>

                                            <% } else { %>
                                                <a class="quick-action-btn" href="/register">
                                                    <span><i class="fa-solid fa-user-plus"></i> Register</span>
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </a>

                                                <a class="quick-action-btn light" href="/login">
                                                    <span><i class="fa-solid fa-right-to-bracket"></i> Login</span>
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </a>
                                                <% } %>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <section class="feature-section">
            <div class="container">

                <div class="text-center mb-5">
                    <h2 class="section-title">Everything students need</h2>
                    <p class="text-secondary">Clean upload, organized library and fast access in one place.</p>
                </div>

                <div class="row g-4">

                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fa-solid fa-filter"></i>
                            </div>
                            <h5 class="fw-bold">Smart Filters</h5>
                            <p>Search content by branch, semester, category and price without confusion.</p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                            </div>
                            <h5 class="fw-bold">Easy Upload</h5>
                            <p>Upload study PDFs with title, price, branch, semester and category.</p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fa-solid fa-bolt"></i>
                            </div>
                            <h5 class="fw-bold">Fast Access</h5>
                            <p>Users can browse, pay and download PDFs with a smooth modern interface.</p>
                        </div>
                    </div>

                </div>
            </div>
        </section>
        <section class="faq-section">
            <div class="container">
                <div class="faq-wrapper">

                    <div class="faq-heading">
                        <h2>
                            <i class="fa-solid fa-circle-question me-2 text-info"></i>
                            Frequently Asked Questions
                        </h2>
                        <p>NoteVoult use karne se related common questions aur unke answers.</p>
                    </div>

                    <div class="faq-box active">
                        <button type="button" class="faq-question">
                            <span>
                                <i class="fa-solid fa-file-pdf"></i>
                                NoteVoult par kaun-kaun se study materials milte hain?
                            </span>
                            <div class="faq-toggle">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                        </button>

                        <div class="faq-answer">
                            <p>
                                NoteVoult par students notes, PDFs, micro papers, semester materials aur project files
                                easily access kar sakte hain.
                            </p>
                        </div>
                    </div>

                    <div class="faq-box">
                        <button type="button" class="faq-question">
                            <span>
                                <i class="fa-solid fa-user-plus"></i>
                                Kya PDF download karne ke liye account banana zaroori hai?
                            </span>
                            <div class="faq-toggle">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                        </button>

                        <div class="faq-answer">
                            <p>
                                Limited features bina account ke access ho sakte hain, lekin full access, upload option
                                aur better experience ke liye register/login karna recommended hai.
                            </p>
                        </div>
                    </div>

                    <div class="faq-box">
                        <button type="button" class="faq-question">
                            <span>
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                Kya main apna PDF ya notes upload kar sakta hoon?
                            </span>
                            <div class="faq-toggle">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                        </button>

                        <div class="faq-answer">
                            <p>
                                Haan, login karne ke baad aap notes, micro papers ya project PDFs upload kar sakte hain.
                                Upload karte time title, branch, semester aur category select karna hota hai.
                            </p>
                        </div>
                    </div>

                    <div class="faq-box">
                        <button type="button" class="faq-question">
                            <span>
                                <i class="fa-solid fa-layer-group"></i>
                                Micro, Notes aur Projects me kya difference hai?
                            </span>
                            <div class="faq-toggle">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                        </button>

                        <div class="faq-answer">
                            <p>
                                Notes regular study material ke liye hain, Micro section CIA/semester micro papers ke
                                liye hai, aur Projects section academic project files ke liye use hota hai.
                            </p>
                        </div>
                    </div>

                    <div class="faq-box">
                        <button type="button" class="faq-question">
                            <span>
                                <i class="fa-solid fa-shield-halved"></i>
                                Admin Dashboard ka access kisko milta hai?
                            </span>
                            <div class="faq-toggle">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                        </button>

                        <div class="faq-answer">
                            <p>
                                Admin Dashboard sirf admin role wale users ke liye available hota hai. Admin users PDFs,
                                subscribers aur website management related actions handle kar sakte hain.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </div>

    <script src="/js/home.js"></script>