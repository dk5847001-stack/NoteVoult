<% layout("layouts/boilerplate.ejs") -%>

<style>
form {
    padding: 20px;
    border: 2px dotted gray;
    border-radius: 20px;
    width: 80%;
    margin: auto;
    box-shadow: 0 10px 20px black;
    background-color: rgb(62, 79, 94);
    color: white;
}

@media (max-width: 576px) {
    form {
        width: 95%;
    }
}
</style>

<form class="mt-3" method="post" action="/pdfs" enctype="multipart/form-data">
    
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input 
            type="text" 
            name="title" 
            id="title" 
            placeholder="Enter your Title" 
            minlength="4"
            maxlength="20"
            required 
            class="form-control">
    </div>

    <div class="mb-3">
        <label for="pdf" class="form-label">Upload PDF</label>
        <input 
            type="file" 
            name="pdf" 
            id="pdf" 
            accept="application/pdf"
            required 
            class="form-control">
    </div>
    <div class="row">
    <div class="mb-3 col-6">
        <label for="price" class="form-label">Price</label>
        <input 
            type="number" 
            name="price" 
            id="price" 
            placeholder="Enter your Price" 
            min="1"
            value="5"
            required 
            class="form-control">
    </div>

    <div class="mb-3 col-6">
        <label for="branch" class="form-label">Branch</label>
        <select name="branch" id="branch" required class="form-select">
            <option value="" selected disabled>Select Branch</option>
            <option value="B.Tech">B.Tech</option>
            <option value="BCA">BCA</option>
            <option value="Agriculture">Agriculture</option>
            <option value="BBA">BBA</option>
            <option value="MBA">MBA</option>
        </select>
    </div>
</div>

<div class="row">
    <div class="mb-3 col-6">
        <label for="semester" class="form-label">Semester</label>
        <select name="semester" id="semester" required class="form-select">
            <option value="" selected disabled>Select Semester</option>
            <% for(let i = 1; i <= 8; i++) { %>
                <option value="<%= i %>">Semester <%= i %></option>
            <% } %>
        </select>
    </div>

    <div class="mb-3 col-6">
        <label for="category" class="form-label">Category</label>
        <select name="category" id="category" class="form-select">
            <option value="notes" selected>Notes</option>
            <option value="micro">Micro</option>
            <option value="projects">Projects</option>
        </select>
    </div>
    </div>

    <button type="submit" class="btn btn-success" id="uploadBtn">
        <span id="btnText">Upload</span>
        <span id="spinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
    </button>
</form>

<script>
    const form = document.querySelector("form");
    const btn = document.getElementById("uploadBtn");
    const spinner = document.getElementById("spinner");
    const text = document.getElementById("btnText");

    form.addEventListener("submit", () => {
        spinner.classList.remove("d-none");
        text.innerText = "Uploading...";
        btn.disabled = true;
    });
</script>