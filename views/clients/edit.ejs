<% layout("layouts/boilerplate.ejs") -%>

<style>
    .upload-page {
        min-height: 90vh;
        width: 100%;
        padding: 24px;
    }

    .upload-card {
        width: 100%;
        max-width: 100%;
        margin: auto;
        border-radius: 32px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(22px);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    }

    .upload-header {
        padding: 34px 38px;
        color: #fff;
        background:
            linear-gradient(135deg, rgba(6, 182, 212, 0.22), rgba(124, 58, 237, 0.22));
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .upload-icon {
        width: 60px;
        height: 60px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        font-size: 1.45rem;
        color: white;
        background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
        box-shadow: 0 16px 35px rgba(37, 99, 235, 0.38);
    }

    .upload-header h1 {
        font-weight: 900;
        margin: 18px 0 8px;
    }

    .upload-header p {
        margin: 0;
        max-width: 780px;
        color: rgba(255, 255, 255, 0.72);
    }

    .upload-form {
        padding: 38px;
        background: rgba(255, 255, 255, 0.96);
    }

    .form-label {
        font-weight: 800;
        color: #334155;
    }

    .input-icon {
        position: relative;
    }

    .input-icon i {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        color: #64748b;
        z-index: 2;
    }

    .premium-input,
    .premium-select {
        height: 54px;
        border-radius: 17px;
        border: 1px solid #dbeafe;
        background-color: #f8fafc;
        padding-left: 46px;
    }

    .premium-input:focus,
    .premium-select:focus {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 0.22rem rgba(13, 202, 240, 0.18);
        background-color: #fff;
    }

    .file-box {
        padding: 22px;
        border-radius: 22px;
        background: linear-gradient(135deg, #f8fafc, #eef2ff);
        border: 1px dashed #60a5fa;
    }

    .file-box small {
        color: #64748b;
        font-weight: 600;
    }

    .btn-premium-upload {
        height: 56px;
        border: none;
        border-radius: 18px;
        font-weight: 900;
        color: white;
        background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
        box-shadow: 0 16px 38px rgba(37, 99, 235, 0.35);
        transition: 0.3s ease;
    }

    .btn-premium-upload:hover {
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 22px 48px rgba(124, 58, 237, 0.42);
    }

    #uploadBtn:disabled {
        cursor: not-allowed;
        opacity: 0.75;
    }

    @media (max-width: 768px) {
        .upload-page {
            padding: 14px;
        }

        .upload-card {
            border-radius: 24px;
        }

        .upload-header,
        .upload-form {
            padding: 24px 18px;
        }
    }
</style>

<section class="upload-page">
    <div class="upload-card">
        <div class="upload-header">
            <div class="upload-icon">
                <i class="fa-solid fa-cloud-arrow-up"></i>
            </div>

            <h1>Update Academic PDF</h1>
            <p>
                Add notes, micro papers, or project files with proper branch,
                semester, and category details.
            </p>
        </div>

        <form class="upload-form needs-validation" method="post" action="/pdfs/<%= pdf._id %>?_method=PUT" enctype="multipart/form-data" novalidate>

            <div class="mb-3">
                <label for="title" class="form-label">
                    <i class="fa-solid fa-heading me-1"></i> Title
                </label>

                <div class="input-icon">
                    <i class="fa-solid fa-pen"></i>
                    <input
                        type="text"
                        name="title"
                        id="title"
                        value="<%= pdf.title %>"
                        minlength="4"
                        maxlength="20"
                        required
                        class="form-control premium-input">
                </div>

                <div class="invalid-feedback">
                    Title must be between 4 and 20 characters.
                </div>
            </div>

            <div class="mb-3 file-box">
                <label for="pdf" class="form-label">
                    <i class="fa-solid fa-file-pdf me-1"></i> Upload PDF
                </label>

                <input
                    type="file"
                    name="pdf"
                    id="pdf"
                    accept="application/pdf"
                    required
                    class="form-control">

                <small class="d-block mt-2">
                    Only PDF files are allowed. Use clear academic file names.
                </small>

                <div class="invalid-feedback">
                    Please upload a PDF file.
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="price" class="form-label">
                        <i class="fa-solid fa-indian-rupee-sign me-1"></i> Price
                    </label>

                    <div class="input-icon">
                        <i class="fa-solid fa-wallet"></i>
                        <input
                            type="number"
                            name="price"
                            id="price"
                            value="<%= pdf.price %>"
                            min="0"
                            value="5"
                            
                            class="form-control premium-input">
                    </div>

                    <div class="invalid-feedback">
                        Price must be at least ₹1.
                    </div>
                </div>

                <div class="mb-3 col-md-6">
                    <label for="branch" class="form-label">
                        <i class="fa-solid fa-code-branch me-1"></i> Branch
                    </label>

                    <div class="input-icon">
                        <i class="fa-solid fa-building-columns"></i>
                        <select name="branch" id="branch" required class="form-select premium-select">
                            <option value="" selected disabled>Select Branch</option>
                            <option value="B.Tech" selected>B.Tech</option>
                            <option value="BCA">BCA</option>
                            <option value="Agriculture">Agriculture</option>
                            <option value="BBA">BBA</option>
                            <option value="MBA">MBA</option>
                        </select>
                    </div>

                    <div class="invalid-feedback">
                        Please select a branch.
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="semester" class="form-label">
                        <i class="fa-solid fa-layer-group me-1"></i> Semester
                    </label>

                    <div class="input-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <select name="semester" id="semester" required class="form-select premium-select">
                            <option value="" selected disabled>Select Semester</option>
                            <% for(let i = 1; i <= 8; i++) { %>
                                <option value="<%= i %>" selected>Semester <%= i %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="invalid-feedback">
                        Please select a semester.
                    </div>
                </div>

                <div class="mb-3 col-md-6">
                    <label for="category" class="form-label">
                        <i class="fa-solid fa-folder-open me-1"></i> Category
                    </label>

                    <div class="input-icon">
                        <i class="fa-solid fa-tags"></i>
                        <select name="category" id="category" required class="form-select premium-select">
                            <option value="notes">Notes</option>
                            <option value="micro" selected>Micro</option>
                            <option value="projects">Projects</option>
                        </select>
                    </div>

                    <div class="invalid-feedback">
                        Please select a category.
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label for="examType" class="form-label">
                    <i class="fa-solid fa-clipboard-check me-1"></i> Exam Type
                </label>

                <div class="input-icon">
                    <i class="fa-solid fa-list-check"></i>
                    <select name="examType" id="examType" required class="form-select premium-select">
                        <option value="" selected disabled>Select Exam Type</option>
                        <option value="CIA">CIA</option>
                        <option value="Semester" selected>Semester</option>
                    </select>
                </div>

                <div class="invalid-feedback">
                    Please select exam type.
                </div>
            </div>

            <button type="submit" class="btn btn-premium-upload w-100" id="uploadBtn">
                <span id="btnText">
                    <i class="fa-solid fa-cloud-arrow-up me-2"></i>
                    Update PDF
                </span>
                <span id="spinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
            </button>
        </form>
    </div>
</section>

<script>
    const form = document.querySelector("form");
    const btn = document.getElementById("uploadBtn");
    const spinner = document.getElementById("spinner");
    const text = document.getElementById("btnText");

    form.addEventListener("submit", (e) => {
        if (!form.checkValidity()) {
            e.preventDefault();
            e.stopPropagation();
            form.classList.add("was-validated");
            return;
        }

        spinner.classList.remove("d-none");
        text.innerHTML = `<i class="fa-solid fa-cloud-arrow-up me-2"></i> Uploading...`;
        btn.disabled = true;
        btn.style.cursor = "not-allowed";

        form.classList.add("was-validated");
    });
</script>