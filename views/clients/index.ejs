<% layout("layouts/boilerplate.ejs") -%>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        .hr-text {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 50px 0;
        }

        .hr-text::before,
        .hr-text::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid #ccc;
        }

        .hr-text:not(:empty)::before {
            margin-right: 10px;
        }

        .hr-text:not(:empty)::after {
            margin-left: 10px;
        }

        .hr-text span {
            font-size: 14px;
            color: #888;
            font-weight: 500;
        }
        hr{
            border-radius: 8px;
            margin-top: -3px !important;
        }

        .premium-tabs {
            max-width: 980px;
            margin: 0 auto 35px;
            padding: 16px;
            /* border-radius: 28px; */
            /* background: rgba(30, 30, 30, 0.78); */
            backdrop-filter: blur(22px);
            /* -webkit-backdrop-filter: blur(22px); */
            /* border: 1px solid rgba(255, 255, 255, 0.25); */
            /* box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28); */
        }

        .premium-tabs nav {
            position: relative;
        }

        .premium-tabs ul {
            display: flex;
            list-style: none;
            padding: 0;
            margin: 0;
            position: relative;
            gap: 12px;
        }

        .premium-tabs li {
            flex: 1;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .premium-tabs a {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
            text-decoration: none;
            color: #fff;
            padding: 14px 10px;
            border-radius: 18px;
            transition: 0.3s ease;
            font-weight: 600;
        }

        .premium-tabs a i {
            font-size: 21px;
            transition: 0.3s ease;
            color: white;
        }

        .premium-tabs li.active a,
        .premium-tabs a:hover {
            color: #ff4d9d;
            background: rgba(255, 255, 255, 0.08);
        }

        .premium-tabs li.active a i,
        .premium-tabs a:hover i {
            color: #ff4d9d;
            transform: translateY(-4px) scale(1.08);
        }

        .tab-indicator {
            position: absolute;
            bottom: -6px;
            height: 3px;
            background: #ff4d9d;
            transition: all 0.3s ease;
            border-radius: 10px;
        }

        .tab-panel {
            display: none;
            animation: fadeUp 0.35s ease;
        }

        .tab-panel.active {
            display: block;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .pdf-card {
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.14);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.24);
            box-shadow: 0 10px 32px rgba(0, 0, 0, 0.26);
            transition: all 0.35s ease;
            overflow: hidden;
            color: #f8fafc;
        }

        .pdf-card:hover {
            transform: translateY(-8px) scale(1.02);
            background: rgba(255, 255, 255, 0.19);
            border-color: rgba(255, 255, 255, 0.38);
            box-shadow: 0 22px 48px rgba(0, 0, 0, 0.38);
        }

        .pdf-icon {
            width: 70px;
            margin: 20px auto 10px;
            filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.35));
        }

        .card-title {
            color: #f8fafc;
            font-weight: 700;
        }

        .card-footer-text {
            font-size: 0.8rem;
            color: #cbd5e1;
        }

        .price-badge {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            padding: 7px 15px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(34, 197, 94, 0.28);
        }

        .btn-premium {
            border-radius: 12px;
            transition: 0.3s;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.7);
            color: #0d6efd;
            font-weight: 600;
        }

        .btn-premium:hover {
            background: #0d6efd;
            color: white;
            transform: scale(1.03);
            box-shadow: 0 10px 25px rgba(13, 110, 253, 0.35);
        }

        .placeholder {
            animation: pulse 1.2s infinite ease-in-out;
            background-color: rgba(255, 255, 255, 0.35) !important;
        }

        @keyframes pulse {
            0% {
                opacity: 0.45;
            }

            50% {
                opacity: 0.95;
            }

            100% {
                opacity: 0.45;
            }
        }

        .tab-panel .text-center h3 {
            color: #f8fafc;
            font-weight: 800;
        }

        .tab-panel .text-muted {
            color: #cbd5e1 !important;
        }

       @media (max-width: 768px) {
    .pdf-page {
        padding: 25px 0 45px;
    }

    .premium-tabs {
        border-radius: 22px;
        padding: 10px;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .premium-tabs ul {
        flex-wrap: nowrap !important;
        justify-content: flex-start;
        gap: 10px;
        min-width: max-content;
        overflow-x: visible !important;
    }

    .premium-tabs li {
        flex: 0 0 auto;
        min-width: auto;
    }

    .premium-tabs a {
        white-space: nowrap;
        padding: 11px 16px;
        font-size: 0.86rem;
    }

    .premium-tabs::-webkit-scrollbar {
        height: 0;
    }
}

        @media (max-width: 576px) {
            .pdf-card {
                padding: 8px !important;
                border-radius: 16px;
            }

            .pdf-icon {
                width: 45px;
                margin: 10px auto 8px;
            }

            .card-title {
                font-size: 0.9rem;
            }

            .card-footer-text {
                font-size: 0.62rem;
            }

            .price-badge {
                padding: 4px 10px;
                font-size: 0.72rem;
            }

            .btn-premium {
                font-size: 0.68rem;
                padding: 6px 4px;
                white-space: nowrap;
            }

            .card-body {
                padding: 8px !important;
            }
        }

        .new-seal {
            position: absolute;
            top: -8px;
            right: -8px;
            background: linear-gradient(135deg, #ff1744, #ff9100);
            color: white;
            font-size: 0.58rem;
            font-weight: 800;
            padding: 4px 7px;
            border-radius: 999px;
            box-shadow: 0 0 12px rgba(255, 23, 68, 0.7);
            animation: sealPulse 1.2s infinite;
            letter-spacing: 0.5px;
        }

        @keyframes sealPulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.12);
            }

            100% {
                transform: scale(1);
            }
        }
    </style>

