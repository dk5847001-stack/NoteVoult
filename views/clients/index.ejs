                                        <h5 class="card-title mb-2">
                                            <%= pdf.title %>
                                        </h5>

                                        <p class="card-footer-text mb-2">
                                            <%= pdf.uploadedAt.toLocaleString() %>
                                        </p>

                                        <div class="mb-3">
                                            <span class="price-badge">
                                                ₹<%= pdf.price %>
                                            </span>
                                        </div>

                                        <a href="/pdfs/download/<%= pdf._id %>"
                                            class="btn btn-outline-primary btn-premium mt-auto download-btn">

                                            <span class="btn-text">
                                                <i class="bi bi-download"></i> Pay & Download
                                            </span>

                                            <span class="loading-text d-none">
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                Downloading...
                                            </span>

                                        </a>

                                    </div>
                                </div>
                            </div>
                            <% } %>

                                <% } else { %>
                                    <div class="col-12 text-center">
                                        <h4 class="text-muted">No PDFs available</h4>
                                    </div>
                                    <% } %>
                </div>
            </section>

            <!-- TAB 2 -->
            <section class="tab-panel">
                <div class="text-center py-5">
                    <!-- <h1>This is more than 10 rupees pdf</h1> -->
