<% layout("layouts/boilerplate.ejs") -%>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/adminDashboard.css" />

    <div class="container-fluid admin-dashboard-container margin mt-4">

        <!-- HEADER -->
        <div class="admin-header">
            <h3>
                👑 <i class="fa-solid fa-user-shield"></i> Welcome, <%= currUser.username %>
            </h3>
            <p class="mb-0">
                <i class="fa-solid fa-gauge-high"></i> Admin Dashboard Panel
            </p>
        </div>

        <div class="row">

            <!-- LEFT: USER INFO -->
            <div class="col-lg-8">

                <div class="user-card">
                    <h6><i class="fa-solid fa-user"></i> Username</h6>
                    <h5>
                        <%= currUser.username %>
                    </h5>
                </div>

                <div class="user-card">
                    <h6><i class="fa-solid fa-envelope"></i> Email</h6>
                    <h5>
                        <%= currUser.email %>
                    </h5>
                </div>

                <div class="user-card">
                    <h6><i class="fa-solid fa-id-badge"></i> Role</h6>
                    <h5>
                        <%= currUser.role %>
                            <% if(currUser.role==="admin" ){ %>
                                👑
                                <% } %>
                    </h5>
                </div>

                <div class="user-card">
                    <h6><i class="fa-solid fa-signal"></i> Status</h6>
                    <h5>
                        <% if(currUser.isBlocked==="blocked" ){ %>
                            <span class="status-badge blocked">
                                <i class="fa-solid fa-ban"></i> Blocked
                            </span>
                            <% } else { %>
                                <span class="status-badge active">
                                    <i class="fa-solid fa-check"></i> Active
                                </span>
                                <% } %>
                    </h5>
                </div>

            </div>

            <!-- RIGHT: ACTION PANEL -->
            <div class="col-lg-4">
                <div class="admin-sidebar">

                    <button id="subscriberBtn" class="admin-btn btn-subs">
                        <i class="fa-solid fa-envelope-open-text"></i>
                        View Subscribers
                    </button>

                    <button id="message" class="admin-btn btn-msg">
                        <i class="fa-solid fa-comments"></i>
                        View Messages
                    </button>

                    <button class="admin-btn btn-users" id="manageUsersBtn">
                        <i class="fa-solid fa-users"></i>
                        Manage Users
                    </button>

                    <button id="pdfs" class="admin-btn btn-pdf">
                        <i class="fa-solid fa-file-pdf"></i>
                        Manage PDFs
                    </button>

                </div>
            </div>

        </div>
        <!--------------------------------------------------------------------------------------------------------------------------------------->
        <!-- USERS SECTION -->
        <div id="section1" class="section1 mt-4">

            <div class="premium-section-header mt-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="icon-box">
                        <i class="fa-solid fa-users"></i>
                    </span>
                    <h5 class="mb-0">User Section</h5>
                </div>
            </div>

            <div class="card admin-panel-card shadow-lg border-0 p-3">
                <!-- HEADER -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-users"></i> Users Management
                    </h5>
                    <span class="badge bg-primary">
                        <i class="fa-solid fa-database"></i> Total: <%= users.length %>
                    </span>
                </div>

                <!-- TABLE -->
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle text-center">

                        <thead>
                            <tr>
                                <th><i class="fa-solid fa-user"></i> Name</th>
                                <th><i class="fa-solid fa-envelope"></i> Email</th>
                                <th><i class="fa-solid fa-id-badge"></i> Role</th>
                                <th><i class="fa-solid fa-signal"></i> Status</th>
                                <th><i class="fa-solid fa-gears"></i> Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% for(let user of users){ %>
                                <tr>

                                    <!-- NAME -->
                                    <td data-label="Name">
                                        <i class="fa-solid fa-circle-user"></i>
                                        <%= user.username %>
                                    </td>

                                    <!-- EMAIL -->
                                    <td data-label="Email">
                                        <%= user.email %>
                                    </td>

                                    <!-- ROLE -->
                                    <td data-label="Role">
                                        <% if(user.role==="admin" ){ %>
                                            <span class="badge bg-warning text-dark">
                                                👑 Admin
                                            </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">
                                                    User
                                                </span>
                                                <% } %>
                                    </td>

                                    <!-- STATUS -->
                                    <td data-label="Status">
                                        <% if(user.isBlocked==="blocked" ){ %>
                                            <span class="badge bg-danger">
                                                <i class="fa-solid fa-ban"></i> Blocked
                                            </span>
                                            <% } else { %>
                                                <span class="badge bg-success">
                                                    <i class="fa-solid fa-check"></i> Active
                                                </span>
                                                <% } %>
                                    </td>

                                    <!-- ACTION -->
                                    <td data-label="Action"
                                        class="user-actions-cell d-flex justify-content-center gap-2">

                                        <% if(user.isBlocked==="active" ){ %>
                                            <a href="/admin/unblock/<%= user._id %>" class="btn btn-success btn-sm">
                                                <i class="fa-solid fa-lock-open"></i>
                                            </a>
                                            <% } else { %>
                                                <a href="/admin/block/<%= user._id %>" class="btn btn-warning btn-sm">
                                                    <i class="fa-solid fa-ban"></i>
                                                </a>
                                                <% } %>

                                                    <form action="/admin/delete/<%= user._id %>?_method=DELETE"
                                                        method="POST" onsubmit="return confirm('Delete this user?')">

                                                        <button class="btn btn-danger btn-sm">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                    <a href="/admin/user/<%= user._id %>" class="btn btn-info btn-sm">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </a>


                                    </td>

                                </tr>
                                <% } %>
                        </tbody>

                    </table>
                </div>

            </div>

        </div>

        <!-- -------------------------------------- Subscriber Section ------------------------------------ -->
        <section id="subscriber" class="subscriber-page">

            <div class="container">

                <div class="subscriber-card">

                    <!-- Header -->
                    <div class="subscriber-header">

                        <h1 class="subscriber-title">
                            <i class="fa-solid fa-envelope-open-text me-2"></i>
                            Subscriber Dashboard
                        </h1>

                        <p class="subscriber-subtitle">
                            Manage and monitor all newsletter subscribers in one place.
                        </p>

                    </div>

                    <!-- Stats -->
                    <div class="stats-box">

                        <div class="stat-card">
                            <h3>
                                <%= allSubscribers.length %>
                            </h3>
                            <p>Total Subscribers</p>
                        </div>

                        <div class="stat-card">
                            <h3>
                                <%= allSubscribers.filter(s=> s.status === "active").length %>
                            </h3>
                            <p>Active Subscribers</p>
                        </div>

                        <div class="stat-card">
                            <h3>
                                <%= allSubscribers.filter(s=> s.status === "inactive").length %>
                            </h3>
                            <p>Inactive Subscribers</p>
                        </div>

                    </div>

                    <!-- Table -->
                    <div class="table-wrapper">

                        <% if(allSubscribers.length> 0){ %>

                            <table>

                                <thead>
                                    <tr>
                                        <th>Email Address</th>
                                        <th>Subscribed Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <% for(let subscriber of allSubscribers){ %>

                                        <tr>

                                            <td data-label="Email Address">
                                                <div class="email-box">

                                                    <div class="email-icon">
                                                        <i class="fa-solid fa-user"></i>
                                                    </div>

                                                    <div class="email-text">
                                                        <%= subscriber.email %>
                                                    </div>

                                                </div>
                                            </td>

                                            <td data-label="Subscribed Time">
                                                <div class="time-text">
                                                    <%= subscriber.subscribedAt.toLocaleString() %>
                                                </div>
                                            </td>

                                            <td data-label="Status">

                                                <span class="
                                            status-badge
                                            <%= subscriber.status === 'active'
                                                ? 'status-active'
                                                : 'status-inactive'
                                            %>
                                        ">

                                                    <i class="fa-solid fa-circle-check"></i>

                                                    <%= subscriber.status %>

                                                </span>

                                            </td>

                                        </tr>

                                        <% } %>

                                </tbody>

                            </table>

                            <% } else { %>

                                <div class="empty-box">

                                    <i class="fa-solid fa-envelope-circle-check"></i>

                                    <h3>No Subscribers Yet</h3>

                                    <p>
                                        Once users subscribe, they will appear here.
                                    </p>

                                </div>

                                <% } %>

                    </div>

                </div>

            </div>

        </section>


        <!--  -------------------------------- Pdf section ------------------------ -->
        <section class="pdf-admin-section">
            <div class="admin-heading-wrapper">
                <div class="admin-heading-line"></div>

                <h2 id="allPdfs" class="admin-heading">
                    <span class="heading-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </span>

                    <span class="heading-text">
                        Manage All PDFs
                    </span>

                    <span class="heading-badge">
                        <i class="fa-solid fa-shield-halved"></i>
                        Admin Panel
                    </span>
                </h2>

                <div class="admin-heading-line"></div>
            </div> <!-- Skeleton Loader -->
            <div class="skeleton-wrapper row g-4">
                <% for(let i=0; i < 8; i++){ %>
                    <div class="col-6 col-sm-6 col-md-4 col-lg-3">
                        <div class="card pdf-card h-100 p-3">
                            <div class="placeholder-glow text-center">
                                <span class="placeholder col-5 rounded-circle ph-avatar"></span>
                            </div>

                            <div class="card-body text-center">
                                <p class="placeholder-glow mb-2">
                                    <span class="placeholder col-9"></span>
                                </p>

                                <p class="placeholder-glow mb-2">
                                    <span class="placeholder col-7"></span>
                                </p>

                                <p class="placeholder-glow mb-3">
                                    <span class="placeholder col-5"></span>
                                </p>

                                <div class="placeholder-glow mb-2">
                                    <span class="placeholder col-12 ph-btn"></span>
                                </div>

                                <div class="row g-2 placeholder-glow">
                                    <div class="col-6">
                                        <span class="placeholder col-12 ph-small-btn"></span>
                                    </div>
                                    <div class="col-6">
                                        <span class="placeholder col-12 ph-small-btn"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
            </div>

           <!-- Real Data -->
<div class="real-data row g-4 d-none">
    <% if(allPdfs && allPdfs.length > 0){ %>

        <% for(let pdf of allPdfs){ %>

            <%
                const now = new Date();
                const unlockDate = pdf.unlockAt ? new Date(pdf.unlockAt) : null;
                const isLocked = unlockDate && unlockDate.getTime() > now.getTime();
            %>

            <div class="col-6 col-sm-6 col-md-4 col-lg-3">
                <div class="card pdf-card h-100 text-center p-3">

                    <img src="https://www.freeiconspng.com/thumbs/pdf-icon-png/pdf-word-icon-31.png"
                        class="pdf-icon" alt="pdf">

                    <div class="card-body d-flex flex-column">

                        <h5 class="pdf-title mb-2">
                            <%= pdf.title %>
                        </h5>

                        <% if(isLocked){ %>
                            <p class="card-footer-text mb-2 countdown-text"
                                data-unlock="<%= unlockDate.getTime() %>"
                                data-uploaded="<%= pdf.uploadedAt ? pdf.uploadedAt.toLocaleString() : 'No date' %>">

                                <i class="fa-solid fa-lock me-1"></i>
                                Unlocking...
                            </p>
                        <% } else { %>
                            <p class="card-footer-text mb-2">
                                <i class="fa-regular fa-clock me-1"></i>
                                <%= pdf.uploadedAt ? pdf.uploadedAt.toLocaleString() : "No date" %>
                            </p>
                        <% } %>

                        <div class="mb-3">
                            <div class="price-pill">
                                <i class="fa-solid fa-circle-check"></i>

                                <span class="old-price">
                                    ₹<del>
                                        <%= pdf.price %>
                                    </del>
                                </span>

                                <span class="free-price">FREE</span>
                            </div>
                        </div>

                        <% if(isLocked){ %>

                            <button type="button"
                                class="btn btn-secondary btn-premium mt-auto locked-download-btn"
                                disabled
                                data-download-url="/pdfs/download/<%= pdf._id %>"
                                data-unlock-action="download">

                                <span>
                                    <i class="fa-solid fa-lock"></i>
                                    Locked
                                </span>
                            </button>

                        <% } else { %>

                            <a href="/pdfs/download/<%= pdf._id %>"
                                class="btn btn-outline-primary btn-premium mt-auto download-btn">

                                <span class="btn-text">
                                    <i class="bi bi-download"></i> Pay & Download
                                </span>

                                <span class="loading-text d-none">
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    Downloading...
                                </span>
                            </a>

                        <% } %>

                        <div class="action-btns">
                            <a href="/pdfs/<%= pdf._id %>/edit" class="btn edit-btn">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </a>

                            <form action="/pdfs/<%= pdf._id %>?_method=DELETE" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this PDF?')">

                                <button type="submit" class="btn delete-btn w-100">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>

        <% } %>

    <% } else { %>
        <div class="col-12">
            <div class="empty-box text-center">
                <i class="fa-solid fa-file-circle-xmark fa-2x mb-3"></i>
                <h4>No PDFs available</h4>
                <p class="mb-0">Upload a PDF to show it here.</p>
            </div>
        </div>
    <% } %>
</div>

        </section>
       <!-- ----------------------- Message Section --------------------------- -->
<section id="allMessages" class="admin-message-section mt-4">

    <div class="admin-heading-wrapper">
        <div class="admin-heading-line"></div>

        <h2 class="admin-heading">
            <span class="heading-icon">
                <i class="fa-solid fa-envelope-open-text"></i>
            </span>

            <span class="heading-text">
                Manage Users Messages
            </span>

            <span class="heading-badge">
                <i class="fa-solid fa-shield-halved"></i>
                Admin Panel
            </span>
        </h2>

        <div class="admin-heading-line"></div>
    </div>

    <div class="message-admin-card">

        <div class="message-admin-header">
            <div>
                <h4>
                    <i class="fa-solid fa-inbox me-2"></i>
                    User Messages
                </h4>
                <p>
                    View, review and manage all contact messages submitted by users.
                </p>
            </div>

            <span class="message-count-badge">
                <i class="fa-solid fa-message"></i>
                <%= allMessages ? allMessages.length : 0 %> Messages
            </span>
        </div>

        <% if(allMessages && allMessages.length > 0) { %>

            <!-- Desktop View -->
            <div class="message-desktop-view">
                <div class="message-table-wrapper mb-3 mt-3">
                    <table class="message-table">
                        <thead>
                            <tr>
                                <th class="col-name">Name</th>
                                <th class="col-email">Email</th>
                                <th class="col-subject">Subject</th>
                                <th class="col-message">Message</th>
                                <th class="col-time">Time</th>
                                <th class="col-action">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% for(let message of allMessages) { %>
                                <tr>
                                    <td>
                                        <div class="message-user-cell">
                                            <div class="message-avatar">
                                                <%= message.name ? message.name.charAt(0).toUpperCase() : "U" %>
                                            </div>

                                            <div class="message-user-content">
                                                <strong><%= message.name %></strong>
                                                <small>User</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <a href="mailto:<%= message.email %>" class="message-email">
                                            <%= message.email %>
                                        </a>
                                    </td>

                                    <td>
                                        <span class="message-subject">
                                            <%= message.subject %>
                                        </span>
                                    </td>

                                    <td>
                                        <p class="message-body-text">
                                            <%= message.message %>
                                        </p>
                                    </td>

                                    <td>
                                        <span class="message-time">
                                            <i class="fa-regular fa-calendar-days me-1"></i>
                                            <%= message.createdAt ? message.createdAt.toLocaleString() : "N/A" %>
                                        </span>
                                    </td>

                                    <td>
                                        <form
                                            method="POST"
                                            action="/contactUs/<%= message._id %>?_method=DELETE"
                                            onsubmit="return confirm('Are you sure you want to delete this message?')">

                                            <button type="submit" class="message-delete-btn">
                                                <i class="fa-solid fa-trash-can"></i>
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Mobile View -->
            <div class="message-mobile-view">
                <% for(let message of allMessages) { %>
                    <div class="message-mobile-card">

                        <div class="message-mobile-top">
                            <div class="message-user-cell">
                                <div class="message-avatar">
                                    <%= message.name ? message.name.charAt(0).toUpperCase() : "U" %>
                                </div>

                                <div class="message-user-content">
                                    <strong><%= message.name %></strong>
                                    <small>User Message</small>
                                </div>
                            </div>

                            <span class="message-mobile-status">New</span>
                        </div>

                        <div class="message-mobile-info">

                            <div class="message-info-box">
                                <span>
                                    <i class="fa-solid fa-envelope"></i>
                                    Email
                                </span>
                                <a href="mailto:<%= message.email %>">
                                    <%= message.email %>
                                </a>
                            </div>

                            <div class="message-info-box">
                                <span>
                                    <i class="fa-solid fa-tag"></i>
                                    Subject
                                </span>
                                <strong><%= message.subject %></strong>
                            </div>

                            <div class="message-info-box">
                                <span>
                                    <i class="fa-solid fa-comment-dots"></i>
                                    Message
                                </span>
                                <p><%= message.message %></p>
                            </div>

                            <div class="message-info-box">
                                <span>
                                    <i class="fa-regular fa-clock"></i>
                                    Time
                                </span>
                                <strong>
                                    <%= message.createdAt ? message.createdAt.toLocaleString() : "N/A" %>
                                </strong>
                            </div>

                        </div>

                        <form
                            method="POST"
                            action="/contactUs/<%= message._id %>?_method=DELETE"
                            onsubmit="return confirm('Are you sure you want to delete this message?')">

                            <button type="submit" class="message-mobile-delete">
                                <i class="fa-solid fa-trash-can"></i>
                                Delete Message
                            </button>
                        </form>

                    </div>
                <% } %>
            </div>

        <% } else { %>

            <div class="message-empty-box">
                <div class="message-empty-icon">
                    <i class="fa-regular fa-envelope-open"></i>
                </div>

                <h4>Message Not Found!</h4>
                <p>Abhi tak kisi user ne contact message submit nahi kiya hai.</p>
            </div>

        <% } %>

    </div>
</section>



        <!--  --------------------------------   Java Script  ------------------------ -->
        <script src="/js/adminDashboard.js"></script>