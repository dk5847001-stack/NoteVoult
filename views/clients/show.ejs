<% layout("layouts/boilerplate.ejs") -%>

<style>
  .service-showcase {
    min-height: 100vh;
    width: 100%;
    padding: 45px 0 70px;
    background:
      linear-gradient(135deg, rgba(2, 6, 23, 0.96), rgba(15, 23, 42, 0.94)),
      radial-gradient(circle at top left, rgba(59, 130, 246, 0.35), transparent 35%),
      radial-gradient(circle at bottom right, rgba(34, 197, 94, 0.28), transparent 35%);
  }

  .sell-card {
    max-width: 1180px;
    margin: auto;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 32px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .preview-wrap {
    position: relative;
    min-height: 460px;
    background:
      linear-gradient(120deg, rgba(13, 110, 253, 0.25), rgba(34, 197, 94, 0.18)),
      url("data:image/jpeg;base64,")
      center/cover no-repeat;
  }

  .preview-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(2, 6, 23, 0.94), rgba(2, 6, 23, 0.58), rgba(2, 6, 23, 0.18));
  }

  .hero-data {
    position: relative;
    z-index: 2;
    max-width: 680px;
    padding: 70px 45px;
    color: white;
  }

  .tag {
    display: inline-flex;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.16);
    color: #86efac;
    border: 1px solid rgba(134, 239, 172, 0.3);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 18px;
  }

  .hero-data h1 {
    font-size: clamp(2rem, 5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .hero-data p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
    max-width: 590px;
  }

  .action-group {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .btn-main {
    border: none;
    border-radius: 999px;
    padding: 13px 26px;
    font-weight: 800;
    color: white;
    background: linear-gradient(135deg, #2563eb, #22c55e);
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.35);
  }

  .btn-main:hover {
    color: white;
    transform: translateY(-2px);
  }

  .btn-soft {
    border-radius: 999px;
    padding: 13px 26px;
    font-weight: 700;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.08);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(15, 23, 42, 0.7);
  }

  .stat-box {
    padding: 26px;
    color: white;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stat-box:last-child {
    border-right: 0;
  }

  .stat-box h3 {
    font-weight: 900;
    margin-bottom: 4px;
  }

  .stat-box span {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }

  .content-area {
    padding: 42px;
    background: #f8fafc;
  }

  .section-title {
    max-width: 680px;
    margin-bottom: 28px;
  }

  .section-title h2 {
    font-weight: 900;
    color: #0f172a;
  }

  .section-title p {
    color: #64748b;
  }

  .feature-card {
    height: 100%;
    padding: 26px;
    border-radius: 24px;
    background: white;
    border: 1px solid #e2e8f0;
    box-shadow: 0 14px 35px rgba(15, 23, 42, 0.07);
    transition: 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 55px rgba(15, 23, 42, 0.13);
  }

  .feature-icon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 1.6rem;
    margin-bottom: 16px;
  }

  .package-box {
    margin-top: 36px;
    padding: 30px;
    border-radius: 28px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: white;
  }

  .price {
    font-size: 2.5rem;
    font-weight: 900;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
  }

  .check-list li {
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.78);
  }

  .check-list li::before {
    content: "✓";
    color: #22c55e;
    font-weight: 900;
    margin-right: 10px;
  }

  @media (max-width: 768px) {
    .service-showcase {
      padding: 18px 10px 45px;
    }

    .sell-card {
      border-radius: 24px;
    }

    .preview-wrap {
      min-height: auto;
    }

    .preview-wrap::after {
      background: rgba(2, 6, 23, 0.78);
    }

    .hero-data {
      padding: 42px 22px;
      text-align: center;
    }

    .action-group {
      justify-content: center;
    }

    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-box {
      padding: 20px;
      text-align: center;
    }

    .content-area {
      padding: 28px 18px;
    }

    .package-box {
      text-align: center;
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .stats-row {
      grid-template-columns: 1fr;
    }

    .stat-box {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .stat-box:last-child {
      border-bottom: 0;
    }

    .btn-main,
    .btn-soft {
      width: 100%;
      text-align: center;
    }
  }
</style>

<section class="service-showcase">
  <div class="container">
    <div class="sell-card">

      <div class="preview-wrap">
        <div class="hero-data">
          <span class="tag">Portfolio & Website Development</span>

          <h1><%= pdf.title %></h1>

          <p>
            Main modern portfolio, business website, landing page aur responsive UI design banata hoon,
            jo mobile aur desktop dono par professional dikhe.
          </p>

          <div class="action-group">
            <a href="#" class="btn btn-main">Order Website</a>
            <a href="#" class="btn btn-soft">View Demo</a>
          </div>
        </div>
      </div>

      <div class="stats-row">
        <div class="stat-box">
          <h3>100%</h3>
          <span>Responsive Design</span>
        </div>
        <div class="stat-box">
          <h3>Fast</h3>
          <span>Loading Website</span>
        </div>
        <div class="stat-box">
          <h3>SEO</h3>
          <span>Basic Setup</span>
        </div>
        <div class="stat-box">
          <h3>Premium</h3>
          <span>Modern Look</span>
        </div>
      </div>

      <div class="content-area">
        <div class="section-title">
          <h2>What I Can Build For You</h2>
          <p>
            Clean design, strong layout, smooth user experience aur professional branding ke saath websites.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-md-6 col-lg-4">
            <div class="feature-card">
              <div class="feature-icon">💼</div>
              <h5 class="fw-bold">Personal Portfolio</h5>
              <p class="text-muted mb-0">
                Students, freelancers, developers aur creators ke liye modern portfolio website.
              </p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="feature-card">
              <div class="feature-icon">🏢</div>
              <h5 class="fw-bold">Business Website</h5>
              <p class="text-muted mb-0">
                Shop, startup, coaching, agency ya local business ke liye professional website.
              </p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="feature-card">
              <div class="feature-icon">🚀</div>
              <h5 class="fw-bold">Landing Page</h5>
              <p class="text-muted mb-0">
                Product, service ya offer promote karne ke liye high-converting landing page.
              </p>
            </div>
          </div>
        </div>

        <div class="package-box">
          <div class="row align-items-center g-4">
            <div class="col-lg-7">
              <h3 class="fw-bold">Start Your Website Today</h3>
              <p class="text-white-50 mb-0">
                Portfolio, business page, landing page ya custom design — sab kuch responsive aur premium look ke saath.
              </p>

              <ul class="check-list">
                <li>Mobile friendly layout</li>
                <li>Modern Bootstrap UI</li>
                <li>Clean sections and strong CTA</li>
              </ul>
            </div>

            <div class="col-lg-5 text-lg-end">
              <div class="price">₹999+</div>
              <p class="text-white-50">Starting price</p>
              <a href="#" class="btn btn-main">Book Now</a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>