<% layout("layouts/boilerplate.ejs") -%>

    <!-- 🔥 Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
        }

        /* 🔥 User Card */
        .card {
            background: #9195a8;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }

        .card h2 {
            margin-bottom: 10px;
        }

        .user-info p {
            margin: 5px 0;
            font-size: 16px;
        }

        .user-info i {
            margin-right: 8px;
            color: #555;
        }

        /* 🔥 Table */
        table {
            width: 100%;
            border-collapse: collapse;
            background: #bcb9b9c9;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        th, td {
            padding: 12px;
            text-align: left;
        }

        th {
            background: #111;
            color: #fff;
        }

        tr:nth-child(even) {
            background: #3B82F6;
        }

        tr:hover {
            background: #8c9aea;
        }

        /* 🔥 Icons styling */
        .icon {
            margin-right: 6px;
            color: #666;
        }

        /* 🔥 Badge */
        .badge {
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 12px;
            background: #e0f7e9;
            color: #0a8f4c;
            margin-left: 5px;
        }

    </style>


<div class="container mt-3">

    <!-- 🔥 User Info Card -->
    <div class="card">
        <h2><i class="fa fa-user"></i> User Details</h2>

        <div class="user-info">
            <p><i class="fa fa-user-circle"></i> <strong>Name:</strong> <%= user.username %></p>
            <p><i class="fa fa-envelope"></i> <strong>Email:</strong> <%= user.email %></p>
        </div>
    </div>

    <!-- 🔥 Login History -->
    <h3><i class="fa fa-clock-rotate-left"></i> Login History</h3>

    <table>
        <tr>
            <th><i class="fa fa-mobile-screen"></i> Device</th>
            <th><i class="fa fa-globe"></i> Browser</th>
            <th><i class="fa fa-laptop"></i> OS</th>
            <th><i class="fa fa-location-dot"></i> Location</th>
            <th><i class="fa fa-clock"></i> Time</th>
        </tr>

        <% logs.forEach((log, index) => { %>
        <tr>
            <td>
                <i class="fa fa-mobile icon"></i>
                <%= log.device %>

                <% if(index === 0) { %>
                    <span class="badge">Current</span>
                <% } %>
            </td>

            <td>
                <i class="fa fa-globe icon"></i>
                <%= log.browser %>
            </td>

            <td>
                <i class="fa fa-laptop icon"></i>
                <%= log.os %>
            </td>

            <td>
                <i class="fa fa-location-dot icon"></i>
                <%= log.location %>
            </td>

            <td>
                <i class="fa fa-clock icon"></i>
                <%= new Date(log.login_time).toLocaleString() %>
            </td>
        </tr>
        <% }) %>

    </table>

</div>
