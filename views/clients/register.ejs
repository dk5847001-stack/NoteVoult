<% layout("layouts/boilerplate.ejs") -%>

<style>
    .register-page {
        min-height: 90vh;
        padding: 50px 0;

    }

    .register-card {
        border-radius: 28px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.16);
        backdrop-filter: blur(20px);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    }

    .register-left {
        padding: 45px;
        color: #fff;
    }

    .register-left h1 {
        font-size: 2.4rem;
        font-weight: 800;
    }

    .register-left p {
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.7;
    }

    .register-left img {
        max-height: 340px;
        filter: drop-shadow(0 25px 35px rgba(0, 0, 0, 0.35));
    }

    .guideline-box {
        margin-top: 25px;
        padding: 20px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.09);
        border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .guideline-box h5 {
        font-weight: 700;
        margin-bottom: 14px;
    }

    .guideline-box ul {
        padding-left: 18px;
        margin-bottom: 0;
        color: rgba(255, 255, 255, 0.78);
        font-size: 0.94rem;
        line-height: 1.8;
    }

    .register-form-area {
        padding: 45px;
        background: rgba(255, 255, 255, 0.96);
    }

    .form-title {
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .form-subtitle {
        color: #64748b;
        margin-bottom: 28px;
    }

    .form-label {
        font-weight: 700;
        color: #334155;
    }

    .premium-input {
        height: 52px;
        border-radius: 16px;
        border: 1px solid #dbeafe;
        background: #f8fafc;
        padding-left: 16px;
    }

    .premium-input:focus {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 0.22rem rgba(13, 202, 240, 0.18);
        background: #fff;
    }

    .password-guide {
        font-size: 0.82rem;
        color: #64748b;
        margin-top: 7px;
    }

    .btn-premium-register {
        height: 52px;
        border: none;
        border-radius: 16px;
        color: #fff;
        font-weight: 800;
        background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
        box-shadow: 0 16px 35px rgba(37, 99, 235, 0.32);
        transition: 0.3s ease;
    }

    .btn-premium-register:hover {
        transform: translateY(-3px);
        box-shadow: 0 22px 45px rgba(124, 58, 237, 0.38);
        color: #fff;
    }

    .login-link {
        text-align: center;
        margin-top: 18px;
        color: #64748b;
    }

    .login-link a {
        text-decoration: none;
        font-weight: 800;
        color: #2563eb;
    }

    @media (max-width: 768px) {
        .register-page {
            padding: 25px 12px;
        }

        .register-left,
        .register-form-area {
            padding: 28px 22px;
        }

        .register-left h1 {
            font-size: 1.8rem;
        }
    }
</style>

<section class="register-page">
    <div class="container">
        <div class="row register-card align-items-stretch">

            <div class="col-lg-6 register-left d-none d-lg-flex flex-column justify-content-center">
                <h1>Create Your NoteVault Account</h1>
                <p>
                    Join our smart PDF sharing platform and access notes, projects,
                    micro papers, and study resources in one secure place.
                </p>

                <div class="text-center my-3">
                    <img
                        src="https://cdni.iconscout.com/illustration/premium/thumb/man-doing-online-registration-illustration-svg-download-png-11538630.png"
                        alt="register"
                        class="img-fluid"
                    >
                </div>

                <div class="guideline-box">
                    <h5>Registration Guidelines</h5>
                    <ul>
                        <li>Use a valid email address for account recovery.</li>
                        <li>Choose a unique username without spaces.</li>
                        <li>Password should contain at least 6 characters.</li>
                        <li>Do not share your account password with anyone.</li>
                        <li>Upload only valid academic PDF resources.</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6 register-form-area">
                <h2 class="form-title">Register Account</h2>
                <p class="form-subtitle">
                    Fill the details below to create your secure account.
                </p>

                <form method="post" action="/register">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <input
                            type="email"
                            name="email"
                            id="email"
                            class="form-control premium-input"
                            placeholder="example@gmail.com"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input
                            type="text"
                            name="username"
                            id="username"
                            class="form-control premium-input"
                            placeholder="Choose a username"
                            minlength="3"
                            required
                        >
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label">Password</label>
                        <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control premium-input"
                            placeholder="Create strong password"
                            minlength="6"
                            required
                        >
                        <div class="password-guide">
                            Minimum 6 characters recommended with letters and numbers.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-premium-register w-100">
                        Create Account
                    </button>

                    <div class="login-link">
                        Already have an account?
                        <a href="/login">Login here</a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>