<style>
    .premium-navbar {
        position: sticky;
        top: 0;
        z-index: 1050;
        padding: 12px 0;
        background:
            linear-gradient(135deg, rgba(2, 6, 23, 0.94), rgba(15, 23, 42, 0.94));
        backdrop-filter: blur(18px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
    }

    .premium-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
    }

    .brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 1rem;
        background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
        box-shadow: 0 12px 30px rgba(37, 99, 235, 0.38);
    }

    .brand-text {
        font-size: 1.35rem;
        font-weight: 900;
        letter-spacing: 0.5px;
        background: linear-gradient(90deg, #38bdf8, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .premium-nav {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .premium-nav .nav-link {
        color: rgba(255, 255, 255, 0.78) !important;
        padding: 10px 16px !important;
        border-radius: 999px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.25s ease;
        border: 1px solid transparent;
    }

    .premium-nav .nav-link i {
        font-size: 0.95rem;
    }

    .premium-nav .nav-link:hover {
        color: white !important;
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.12);
        transform: translateY(-2px);
    }

    .premium-nav .active {
        background: linear-gradient(135deg,
                rgba(6, 182, 212, 0.22),
                rgba(124, 58, 237, 0.22));
        color: white !important;
        border-color: rgba(56, 189, 248, 0.28);
    }

    .premium-badge {
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 900;
        background: linear-gradient(135deg, #86efac, #22c55e);
        color: #052e16;
        box-shadow: 0 10px 25px rgba(34, 197, 94, 0.25);
    }

    .auth-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .auth-btn {
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.25s ease;
        color: white;
    }

    .btn-register,
    .btn-upload {
        background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
        box-shadow: 0 14px 35px rgba(37, 99, 235, 0.35);
    }

    .btn-register:hover,
    .btn-upload:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(124, 58, 237, 0.42);
    }

    .btn-login {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .btn-login:hover {
        color: white;
        background: rgba(255, 255, 255, 0.16);
        transform: translateY(-2px);
    }

    .btn-logout {
        background: rgba(239, 68, 68, 0.14);
        border: 1px solid rgba(239, 68, 68, 0.32);
        color: #fecaca;
    }

    .btn-logout:hover {
        color: white;
        background: rgba(239, 68, 68, 0.24);
        transform: translateY(-2px);
    }

    .user-pill {
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.88);
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .navbar-toggler {
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: none !important;
    }

    .navbar-toggler-icon {
        filter: invert(1);
    }

    @media (max-width: 991px) {

        .premium-nav,
        .auth-actions {
            margin-top: 18px;
            width: 100%;
        }

        .premium-nav .nav-link,
        .auth-btn,
        .user-pill {
            width: 100%;
            justify-content: center;
            margin-bottom: 8px;
        }

        .auth-actions {
            flex-direction: column;
        }
    }
</style>

<nav class="navbar navbar-expand-lg premium-navbar">
    <div class="container-fluid px-lg-4">

        <!-- Brand -->
        <a class="premium-brand" href="/pdfs">
            <div class="brand-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <span class="brand-text">
                NoteVault
            </span>
        </a>

        <!-- Toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#premiumNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar -->
        <div class="collapse navbar-collapse" id="premiumNavbar">

            <!-- Center Links -->
            <div class="navbar-nav premium-nav mx-auto">

                <a class="nav-link active" href="/">
                    <i class="fa-solid fa-house"></i>
                    Home
                </a>

                <a class="nav-link" href="/pdfs">
                    <i class="fa-solid fa-file-pdf"></i>
                    All PDFs
                </a>

                <% if(currUser){ %>
                    <a class="nav-link" href="/pdfs/new">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        Upload
                    </a>
                    <% } %>

                        <span class="premium-badge">
                            <i class="fa-solid fa-crown me-1"></i>
                            PRO+
                        </span>
            </div>

            <!-- Right Side -->
            <div class="auth-actions ms-auto">
                <% if(!currUser){ %>

                    <a href="/register" class="auth-btn btn-register">
                        <i class="fa-solid fa-user-plus"></i>
                        Register
                    </a>

                    <a href="/login" class="auth-btn btn-login">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Login
                    </a>

                    <% } else { %>
                        <a href="/admin" class="auth-btn btn-register">
                            <i class="fa-solid fa-user-shield"></i>
                            Admin
                        </a>

                        <div class="user-pill">
                            <i class="fa-solid fa-user"></i>
                            <%= currUser.username %>
                        </div>

                        <a href="/logout" class="auth-btn btn-logout">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            Logout
                        </a>

                        <% } %>

            </div>
        </div>
    </div>
</nav>