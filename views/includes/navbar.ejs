<link rel="stylesheet" href="/css/navbar.css">

<nav class="navbar navbar-expand-lg premium-navbar">
    <div class="container-fluid px-lg-4">

        <a class="premium-brand" href="/pdfs">
            <div class="brand-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <span class="brand-text">NoteVault</span>
        </a>

        <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#premiumNavbar"
            aria-controls="premiumNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="toggler-lines">
                <span></span>
                <span></span>
                <span></span>
            </span>
        </button>

        <div class="collapse navbar-collapse" id="premiumNavbar">

            <div class="navbar-nav premium-nav mx-auto">
                <a class="nav-link active" href="/">
                    <i class="fa-solid fa-house"></i>
                    Home
                </a>

                <a class="nav-link active" href="/pdfs">
                    <i class="fa-solid fa-file-pdf"></i>
                    All PDFs
                </a>

                <% if(currUser){ %>
                    <a class="nav-link active" href="/pdfs/new">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        Upload
                    </a>
                <% } %>
            </div>

            <div class="auth-actions ms-auto">

                <% if(!currUser){ %>

                    <a href="/register" class="auth-btn btn-register">
                        <i class="fa-solid fa-user-plus"></i>
                        Register
                    </a>

                    <a href="/login" class="auth-btn btn-login">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Login
                    </a>

                <% } else { %>

                    <span class="premium-badge">
                        <i class="fa-solid fa-crown me-1"></i>
                        PRO+
                    </span>

                    <% if(currUser.role === "admin"){ %>
                        <a href="/admin" class="button-wrapper">
                            <span class="button">
                                <i class="fa-solid fa-user-shield"></i>
                                &nbsp;Admin
                            </span>
                        </a>
                    <% } %>

                    <button class="user-pill" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#userProfileCanvas" aria-controls="userProfileCanvas">
                        <i class="fa-solid fa-user"></i>
                        <%= currUser.username %>
                        <i class="fa-solid fa-angle-left"></i>
                    </button>

                    <a href="/logout" class="auth-btn btn-logout">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        Logout
                    </a>

                <% } %>

            </div>
        </div>
    </div>
</nav>

<% if(currUser){ %>
    <div class="offcanvas offcanvas-end premium-profile-canvas" tabindex="-1" id="userProfileCanvas"
        aria-labelledby="userProfileCanvasLabel">

        <div class="offcanvas-header profile-canvas-header">
            <div>
                <h5 class="offcanvas-title" id="userProfileCanvasLabel">My Profile</h5>
                <p>Manage your account details</p>
            </div>

            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
        </div>

        <div class="offcanvas-body">

            <div class="profile-card">
                <div class="profile-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>

                <h4><%= currUser.username %></h4>

                <span class="role-badge">
                    <i class="fa-solid fa-crown"></i>
                    <%= currUser.role %>
                </span>
            </div>

            <div class="profile-info">

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div>
                        <small>Username</small>
                        <strong><%= currUser.username %></strong>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <small>Email</small>
                        <strong><%= currUser.email %></strong>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <small>Role</small>
                        <strong><%= currUser.role %></strong>
                    </div>
                </div>

            </div>

            <div class="profile-actions">

                <% if(currUser.role === "admin"){ %>
                    <a href="/admin" class="profile-action admin-action">
                        <i class="fa-solid fa-user-shield"></i>
                        Admin Dashboard
                    </a>
                <% } %>

                <a href="/pdfs/new" class="profile-action upload-action">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    Upload PDF
                </a>

                <a href="/logout" class="profile-action logout-action">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logout
                </a>

            </div>
        </div>
    </div>
<% } %>