<style>
.premium-footer {
    position: relative !important;
    width: 100%;
    margin-top: 60px;
    padding: 45px 0 22px;
    background: linear-gradient(135deg, rgba(2, 6, 23, 0.98), rgba(15, 23, 42, 0.98));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 -18px 45px rgba(0, 0, 0, 0.35);
    color: rgba(255, 255, 255, 0.8);
    overflow: hidden;
}

.footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}

.footer-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
    color: white;
    font-size: 0.95rem;
}

.footer-title {
    font-size: 1.25rem;
    font-weight: 900;
    background: linear-gradient(90deg, #38bdf8, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.footer-text {
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 0;
}

.social-icons {
    display: flex;
    gap: 10px;
    margin-top: 14px;
}

.social-icons a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: white;
    background: rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition: 0.25s ease;
    font-size: 0.9rem;
}

.social-icons a:hover {
    background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
    transform: translateY(-3px);
}

/* Subscribe Box */
.subscribe-box {
    margin-top: 18px;
    padding: 16px;
    border-radius: 18px;
    background: rgba(255,255,255,0.055);
    border: 1px solid rgba(255,255,255,0.1);
}

.subscribe-box form {
    width: 100%;
    margin: 0;
}

.input-icon {
    position: relative;
    width: 100%;
    margin-bottom: 10px;
}

.input-icon i {
    position: absolute;
    top: 50%;
    left: 16px;
    transform: translateY(-50%);
    color: #64748b;
    z-index: 5;
    font-size: 1rem;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.subscribe-input {
    width: 100%;
    height: 52px;
    border-radius: 10px;
    border: 2px solid #0e7aaa;
    padding: 0 14px 0 48px !important;
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 52px;
    background: #f8fafc;
    color: #0f172a;
    display: block;
}

.subscribe-input::placeholder {
    color: #64748b;
    font-size: 0.95rem;
}
.subscribe-box .form-control {
    padding-left: 48px !important;
}

.subscribe-input:focus {
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.22);
    border-color: #38bdf8;
}

.subscribe-btn {
    width: 100%;
    height: 44px;
    border-radius: 12px;
    border: none;
    font-weight: 800;
    background: linear-gradient(135deg, #06b6d4, #2563eb, #7c3aed);
    color: white;
    font-size: 0.92rem;
}

.subscribe-btn:disabled {
    opacity: 0.75;
    cursor: not-allowed;
}

/* Links */
.footer-links h5 {
    font-size: 0.98rem;
    margin-bottom: 12px;
    font-weight: 800;
    color: white;
}

.footer-links a {
    display: block;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 8px;
    transition: 0.25s ease;
    font-size: 0.88rem;
}

.footer-links a:hover {
    color: white;
    transform: translateX(4px);
}

.footer-bottom {
    margin-top: 32px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    font-size: 0.78rem;
}

/* Mobile Responsive */
@media (max-width: 767px) {
    .premium-footer {
        margin-top: 35px;
        padding: 34px 0 18px;
    }

    .premium-footer .container {
        padding-left: 14px;
        padding-right: 14px;
    }

    .footer-main-col {
        margin-bottom: 22px;
    }

    .footer-link-col {
        width: 50%;
        margin-bottom: 20px;
    }

    .footer-links h5 {
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .footer-links a {
        font-size: 0.78rem;
        margin-bottom: 7px;
    }

    .subscribe-box {
        padding: 14px;
        border-radius: 16px;
        max-width: 100%;
    }

    .subscribe-input {
        height: 44px;
        font-size: 0.82rem;
        padding-left: 40px;
    }

    .subscribe-btn {
        height: 42px;
        font-size: 0.84rem;
    }

    .footer-bottom {
        margin-top: 15px;
        font-size: 0.72rem;
    }
}
</style>

<footer class="premium-footer">
    <div class="container">

        <div class="row">

            <div class="col-md-4 footer-main-col">
                <div class="footer-brand">
                    <div class="footer-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div class="footer-title">NoteVault</div>
                </div>

                <p class="footer-text">Premium platform for PDFs & notes.</p>

                <div class="social-icons">
                    <a href="#"><i class="fab fa-github"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>

                <div class="subscribe-box">
                    <form id="subscribeForm" method="post" action="/subscribers">
                        <div class="input-icon">
                            <i class="fa-solid fa-envelope"></i>
                            <input
                                type="email"
                                name="email"
                                class="form-control subscribe-input"
                                placeholder="Enter your email"
                                required>
                        </div>

                        <button type="submit" class="subscribe-btn" id="subBtn">
                            <span id="subText">
                                <i class="fa-solid fa-paper-plane me-1"></i>
                                Subscribe
                            </span>

                            <span class="spinner-border spinner-border-sm d-none" id="subSpinner"></span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-md-2 footer-links footer-link-col">
                <h5>Explore</h5>
                <a href="/">Home</a>
                <a href="/pdfs">All PDFs</a>
                <a href="/pdfs/new">Upload</a>
            </div>

            <div class="col-md-3 footer-links footer-link-col">
                <h5>Account</h5>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            </div>

            <div class="col-md-3 footer-links footer-link-col">
                <h5>Support</h5>
                <a href="#">Help Center</a>
                <a href="#">Privacy</a>
            </div>

        </div>

        <div class="footer-bottom">
            © <%= new Date().getFullYear() %> NoteVault
        </div>

    </div>
</footer>

<script>
const form = document.getElementById("subscribeForm");
const btn = document.getElementById("subBtn");
const text = document.getElementById("subText");
const spinner = document.getElementById("subSpinner");

if (form && btn && text && spinner) {
    form.addEventListener("submit", () => {
        spinner.classList.remove("d-none");
        text.innerHTML = "Subscribing...";
        btn.disabled = true;
    });
}
</script>