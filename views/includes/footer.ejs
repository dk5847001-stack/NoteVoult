<link rel="stylesheet" href="/css/footer.css">

<footer class="premium-footer">
    <div class="container">
        <div class="row g-4">

            <div class="col-lg-4 col-md-6 footer-main-col">
                <div class="footer-brand">
                    <div class="footer-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div class="footer-title">NoteVault</div>
                </div>

                <p class="footer-text">
                    Premium platform for PDFs, notes, micro papers and academic projects.
                </p>
                <a href="/contactUs" class="footer-action-btn">
                    <span><i class="fa-solid fa-headset"></i>&nbsp; Contact Us</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <div class="social-icons">
                    <a href="#"><i class="fab fa-github"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>

                <div class="subscribe-box">
                    <form id="subscribeForm" method="post" action="/subscribers">
                        <div class="input-icon">
                            <i class="fa-solid fa-envelope"></i>
                            <input type="email" name="email" class="form-control subscribe-input"
                                placeholder="Enter your email" required>
                        </div>

                        <button type="submit" class="subscribe-btn" id="subBtn">
                            <span id="subText">
                                <i class="fa-solid fa-paper-plane me-1"></i>
                                Subscribe
                            </span>
                            <span class="spinner-border spinner-border-sm d-none" id="subSpinner"></span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-2 col-md-3 footer-links footer-link-col">
                <h5>Explore</h5>
                <a href="/">Home</a>
                <a href="/pdfs">All PDFs</a>
                <a href="/pdfs">Notes</a>
                <a href="/pdfs">Micro</a>
            </div>

            <div class="col-lg-2 col-md-3 footer-links footer-link-col">
                <h5>Account</h5>
                <% if(currUser){ %>
                    <a href="/pdfs">Profile</a>
                    <a href="/pdfs/new">Upload PDF</a>
                    <a href="/contactUs">Contact Us</a>
                    <a href="/logout">Logout</a>
                    <% } else { %>
                        <a href="/login">Login</a>
                        <a href="/register">Register</a>
                        <a href="/contactUs">Contact Us</a>
                        <% } %>
            </div>

            <div class="col-lg-4 col-md-12 footer-actions">
                <h5>Quick Actions</h5>

                <div class="footer-action-grid">
                    <a href="/pdfs" class="footer-action-btn">
                        <span><i class="fa-solid fa-file-pdf me-1"></i> All PDFs</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <a href="/pdfs" class="footer-action-btn">
                        <span><i class="fa-solid fa-book-open me-1"></i> Notes</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <a href="/pdfs" class="footer-action-btn">
                        <span><i class="fa-solid fa-flask-vial me-1"></i> Micro</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <a href="/pdfs" class="footer-action-btn">
                        <span><i class="fa-solid fa-diagram-project me-1"></i> Projects</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <% if(currUser){ %>
                        <a href="/pdfs/new" class="footer-action-btn">
                            <span><i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                        <% if(currUser.role==="admin" ){ %>
                            <a href="/admin" class="footer-action-btn">
                                <span><i class="fa-solid fa-user-shield me-1"></i> Admin</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <% } %>
                                <% } else { %>
                                    <a href="/register" class="footer-action-btn">
                                        <span><i class="fa-solid fa-user-plus me-1"></i> Register</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>

                                    <a href="/login" class="footer-action-btn">
                                        <span><i class="fa-solid fa-right-to-bracket me-1"></i> Login</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                    <a href="/contactUs" class="footer-action-btn">
                                        <span><i class="fa-solid fa-right-to-bracket me-1"></i> Contact Us</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                    <% } %>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            © <%= new Date().getFullYear() %> NoteVault. All rights reserved.
        </div>
    </div>
</footer>

<script src="/js/footer.js"></script>