<% layout("layouts/boilerplate.ejs") -%>

<style>
  .error-page {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background:
      radial-gradient(circle at top left, rgba(13, 110, 253, 0.35), transparent 35%),
      radial-gradient(circle at bottom right, rgba(111, 66, 193, 0.35), transparent 35%),
      linear-gradient(135deg, #020617, #0f172a);
    overflow: hidden;
    position: relative;
  }

  .error-page::before {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: rgba(0, 255, 255, 0.15);
    filter: blur(80px);
    top: -120px;
    right: -120px;
  }

  .error-page::after {
    content: "";
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: rgba(168, 85, 247, 0.18);
    filter: blur(90px);
    bottom: -140px;
    left: -100px;
  }

  .error-card {
    width: 100%;
    max-width: 780px;
    text-align: center;
    padding: 55px 35px;
    border-radius: 30px;
    position: relative;
    z-index: 2;
    color: white;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(22px);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .error-code {
    font-size: clamp(5rem, 18vw, 11rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -8px;
    background: linear-gradient(90deg, #38bdf8, #a78bfa, #22c55e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 45px rgba(56, 189, 248, 0.25);
  }

  .error-title {
    font-size: clamp(1.7rem, 4vw, 3rem);
    font-weight: 800;
    margin-top: 18px;
  }

  .error-text {
    max-width: 560px;
    margin: 15px auto 30px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-future {
    border: none;
    padding: 13px 26px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    color: white;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    box-shadow: 0 12px 35px rgba(37, 99, 235, 0.35);
    transition: 0.3s ease;
  }

  .btn-future:hover {
    transform: translateY(-4px);
    color: white;
    box-shadow: 0 18px 45px rgba(124, 58, 237, 0.45);
  }

  .btn-ghost {
    padding: 13px 26px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
    transition: 0.3s ease;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-4px);
    color: white;
  }

  .orbit {
    width: 130px;
    height: 130px;
    border: 1px dashed rgba(255, 255, 255, 0.28);
    border-radius: 50%;
    margin: 0 auto 20px;
    position: relative;
    animation: spin 8s linear infinite;
  }

  .orbit span {
    position: absolute;
    width: 18px;
    height: 18px;
    background: #38bdf8;
    border-radius: 50%;
    top: 12px;
    left: 20px;
    box-shadow: 0 0 25px #38bdf8;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 576px) {
    .error-card {
      padding: 42px 22px;
      border-radius: 24px;
    }

    .error-code {
      letter-spacing: -4px;
    }
  }
</style>

<section class="error-page">
  <div class="error-card">
    <div class="orbit">
      <span></span>
    </div>

    <div class="error-code">404</div>

    <h1 class="error-title">Page Lost in Digital Space</h1>

    <p class="error-text">
      The page you are looking for does not exist, was moved, or the link is broken.
      Let’s get you back to your PDF dashboard.
    </p>

    <div class="error-actions">
      <a href="/pdfs" class="btn-future">
        Back to PDFs
      </a>

      <a href="/pdfs/new" class="btn-ghost">
        Upload PDF
      </a>
    </div>
  </div>
</section>